{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ms-todo-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "cache": { "enabled": false },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MicrosoftTodoMCP", "MicrosoftTokenVault", "MicrosoftOAuthStateVault"]
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "MCP_OBJECT", "class_name": "MicrosoftTodoMCP" },
      { "name": "MICROSOFT_TOKEN_VAULT", "class_name": "MicrosoftTokenVault" },
      { "name": "MICROSOFT_OAUTH_STATE", "class_name": "MicrosoftOAuthStateVault" }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "00000000000000000000000000000000"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false }
  },
  "dev": { "port": 8787 }
}
